APP_NAME=CHIQUISTRUKIS API
APP_ENV=development
APP_DEBUG=true

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1

# Start Redis first: cd infra/redis && docker compose up -d
REDIS_URL=redis://127.0.0.1:6379/0

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Desarrollo local sin Redis. En producción usar false y levantar infra/redis.
APP_ALLOW_MEMORY_SESSION=true
